---
import MainLayout from "../layouts/MainLayout.astro";

const path = Astro.url.pathname;
---

<MainLayout title="404 — command not found" command={path} cwd="~">
    <div class="out err">command not found: {path}</div>
    <div class="out spacer"></div>
    <div class="out dim prose">
        The page you are looking for has been moved or doesn't exist.
    </div>
    <div class="out spacer"></div>
    <div class="out">
        Try <a class="link" href="/">home</a> or <a class="link" href="/blog">blog</a>,
        or type <span class="ok">help</span>.
    </div>
</MainLayout>
