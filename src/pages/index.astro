---
import MainLayout from "../layouts/MainLayout.astro";
import { ABOUT, SOCIALS } from "../lib/commands";
---

<MainLayout title="Home" command="about" cwd="~" directory>
    {
        ABOUT.map((row) => {
            if (row.kind === "spacer") return <div class="out spacer" />;
            if (row.kind === "name") {
                return <div class="out intro-name">{row.text}</div>;
            }
            if (row.kind === "role") return <div class="out dim">{row.text}</div>;
            if (row.kind === "prose") {
                return (
                    <div class="out prose">
                        {row.parts?.map((part) =>
                            typeof part === "string" ? (
                                part
                            ) : (
                                <span class="ok">{part.text}</span>
                            ),
                        )}
                    </div>
                );
            }
            return (
                <div class="out socials">
                    {SOCIALS.map((social) => (
                        <a
                            class="link"
                            href={social.href}
                            target={social.external ? "_blank" : undefined}
                            rel={social.external
                                ? "noopener noreferrer"
                                : undefined}
                        >
                            {social.label}
                        </a>
                    ))}
                </div>
            );
        })
    }
</MainLayout>
